{#
  Seitengerüst aller Seiten der Hersch-Edition (Kopf, Menü, Fuss).
  Struktur und Texte aus templates/vorlage/hersch-base.html und hersch-menu.html.

  Erwartete Variablen (alle Pfade RELATIV zur aktuellen Seite):
    root    Weg zur Startseite der Site, z. B. ""  oder "../../"
    assets  Weg zum gemeinsamen Asset-Ordner, z. B. "edition/assets" oder "../assets"
  Blöcke: title, styles, body_class, breadcrumbs, content, scripts
-#}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Edition Jeanne Hersch{% endblock %}</title>
  <link rel="icon" type="image/x-icon" href="{{ assets }}/img/favicon.ico">
  <link rel="icon" type="image/png" href="{{ assets }}/img/favicon-32.png" sizes="32x32">
  <link rel="preload" href="{{ assets }}/fonts/eb-garamond-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ assets }}/fonts/ESRebondGrotesque-Medium.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ assets }}/fonts/fonts.css">
  {% block styles %}{% endblock %}
</head>
<body id="top" class="{% block body_class %}{% endblock %}">

  <header class="site-header">
    <a href="{{ root }}index.html" class="logo" aria-label="Edition Jeanne Hersch – Startseite">
      <img src="{{ assets }}/img/logo-wide-transparent.svg" alt="Edition Jeanne Hersch" class="logo-wide">
    </a>

    <nav class="header-nav" aria-label="Hauptnavigation">
      <details>
        <summary>
          {# Sprachumschalter: Funktion folgt in Phase 6 #}
          <span class="languages">
            <a href="?lang=de" data-lang="de" aria-current="true">de</a>
            <a href="?lang=fr" data-lang="fr">fr</a>
            <a href="?lang=en" data-lang="en">en</a>
          </span>
          <span class="header-nav__btn">
            <span class="header-nav__label" data-i18n="menu.menu">Menu</span>
            <img class="menu-icon" src="{{ assets }}/img/but-menu-home.svg" alt="" aria-hidden="true">
            <img class="close-icon" src="{{ assets }}/img/but-menu-close.svg" alt="Menü schliessen">
          </span>
        </summary>
        <ul>
          <li class="search-item">
            <form action="{{ root }}search.html">
              <input type="search" name="q" placeholder="Website durchsuchen" data-i18n-placeholder="search.placeholder" aria-label="Suche">
              <img class="search-glass" src="{{ assets }}/img/ico-glass.svg" alt="">
            </form>
          </li>
          <li><a href="{{ root }}index.html" data-i18n="menu.home">Start</a></li>
          <li><a href="{{ root }}works.html" data-i18n="menu.works">Werke</a></li>
          <li><a href="{{ root }}people.html" data-i18n="menu.people">Personen</a></li>
          <li><a href="{{ root }}search.html" data-i18n="menu.search">Suche</a></li>
          <li><a href="{{ root }}about.html" data-i18n="menu.about">Über die Edition</a></li>
        </ul>
      </details>
    </nav>
  </header>

  <nav aria-label="Brotkrumen" class="breadcrumb">
    <ul>
      <li><a href="{{ root }}index.html" data-i18n="menu.home">Home</a></li>
      {% block breadcrumbs %}{% endblock %}
    </ul>
  </nav>

  {% block content %}{% endblock %}

  <footer class="site-footer">
    <div class="footer__inner">
      <nav class="footer__nav" aria-label="Fussnavigation">
        <a href="{{ root }}index.html" data-i18n="menu.home">Home</a>
        <a href="{{ root }}works.html" data-i18n="menu.works">Werke</a>
        <a href="{{ root }}about.html" data-i18n="menu.project">Projekt</a>
      </nav>
      <div class="footer__logo">
        <img src="{{ assets }}/img/logo-zb-bw.svg" alt="Zentralbibliothek Zürich">
      </div>
    </div>
    <div class="footer__legal">
      <span>© 2026 Zentralbibliothek Zürich</span>
      <a href="{{ root }}imprint.html" data-i18n="landing.imprint">Impressum</a>
      <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.de" rel="license">Texte: CC BY-SA 4.0</a>
    </div>
  </footer>

  <a class="to-top" href="#top" aria-label="Nach oben" data-i18n-aria-label="toolbar.top"><img src="{{ assets }}/img/arrow-up.svg" alt=""></a>

  {% block scripts %}{% endblock %}
</body>
</html>
