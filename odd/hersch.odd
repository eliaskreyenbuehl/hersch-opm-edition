    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" source="teipublisher.odd"> <elementSpec ident="persName" mode="change">
                    <model output="fo" behaviour="inline"/>
                    <model output="print" behaviour="inline"/>
                    <model output="print" predicate="contains(@ref, 'GND-')" behaviour="link" cssClass="entity">
            <param name="uri" value="'https://d-nb.info/gnd/' || substring-after(@ref, 'GND-')"/>
            <param name="target" value="'_blank'"/>
            <param name="content" value="."/>
        </model>
                    <model output="docx" behaviour="inline"/>
                    <model predicate="(@key or @ref) and $parameters?mode='register-details'" behaviour="link">
            <param name="uri" value="head((@key, @ref))"/>
            <param name="target" value="'_blank'"/>
        </model>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
            <desc>Register sidebar</desc>
            <param name="content" value="."/>
            <param name="alternate" value="parent::person/note"/>
            <param name="uri" value="$parameters?context-path || '/people/' || parent::person/@xml:id"/>
            <pb:template xml:space="preserve"><a xmlns="" href="[[uri]]" class="persName">
                        <pb-popover>
                            <span slot="default">[[content]]</span>
                            <template slot="alternate">[[alternate]]</template>
                        </pb-popover>
                        </a></pb:template>
        </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline">
            <desc>When filtering/browsing the register, persons mentioned in descriptions, etc. are inlined</desc>
        </model>
                    <model predicate="@type='variant'" behaviour="inline" cssClass="name variant"/>
                    <model predicate="parent::person" behaviour="inline"/>
                    <model predicate="ancestor::correspContext" behaviour="inline">
            <desc>do not resolve correspContext descriptions</desc>
        </model>
                    <model predicate="@key or @ref" behaviour="alternate" cssClass="persName context">
            <param name="default" value="."/>
            <param name="alternate" value="let $key:= head((@key, @ref)) let $resolved := id($key, collection($global:register-root)/id('zbz-hersch-persons')) return if (count($resolved)) then $resolved else $key"/>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="orgName" mode="change">
                    <model output="fo" behaviour="inline"/>
                    <model output="print" behaviour="inline"/>
                    <model output="print" predicate="contains(@ref, 'GND-')" behaviour="link" cssClass="entity">
            <param name="content" value="."/>
            <param name="uri" value="'https://d-nb.info/gnd/' || substring-after(@ref, 'GND-')"/>
            <param name="target" value="'_blank'"/>
        </model>
                    <model predicate="@key and $parameters?mode='register-details'" behaviour="inline">
            <param name="content" value="let $key:= head((@key, @ref)) return id($key, collection($global:register-root)/id('pb-organizations'))/placeName[@type='main']/string()"/>
        </model>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="link">
            <desc>Register sidebar</desc>
            <param name="uri" value="$parameters?context-path || '/organizations/' || parent::org/@xml:id"/>
        </model>
                    <model predicate="@type='variant'" behaviour="inline" cssClass="name variant"/>
                    <model predicate="parent::org" behaviour="inline"/>
                    <model predicate="ancestor::correspContext" behaviour="inline"/>
                    <model predicate="@key or @ref" behaviour="alternate" cssClass="orgName context">
            <param name="default" value="."/>
            <param name="alternate" value="let $key:= head((@key, @ref)) return id($key, collection($global:register-root)/id('zbz-hersch-organizations'))"/>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
            <elementSpec ident="teiHeader" mode="change">
                    <model predicate="$parameters?mode eq 'citation'" behaviour="section">
            <param name="content" value="ext:retrieve-reference(., 'web')"/>
        </model>
                    <model output="latex" behaviour="metadata"/>
                    <model output="fo" behaviour="omit"/>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="inline">
            <param name="content" value="fileDesc/titleStmt"/>
        </model>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through"/>
                    <model predicate="$parameters?display='browse'" behaviour="block" cssClass="document-item">
            <param name="content" value="fileDesc/titleStmt"/>
        </model>
                    <model predicate="not(descendant::catRef[@scheme = 'hersch_worktype']/@target eq '#text')" behaviour="block">
            <param name="content" value="//sourceDesc/biblStruct"/>
        </model>
                    <model behaviour="metadata"/>
                </elementSpec>
                <elementSpec ident="titleStmt" mode="change">
                    <model output="latex" behaviour="metadata"/>
                    <model output="fo" behaviour="heading"/>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="inline">
            <desc>for breadcrumbs, pick only the first title</desc>
            <param name="content" value="title[1]"/>
        </model>
                    <model predicate="$parameters?mode='register-details'" behaviour="listItem">
            <desc>List of letters in register detail view</desc>
            <param name="content" value="head((title[@type='main'], title))"/>
        </model>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="block"/>
                    <modelSequence output="web" predicate="$parameters?display='browse'">
            <desc>Display short metadata in document lists in the browse view</desc>
            <model behaviour="block">
                <param name="content" value="title[1]"/>
            </model>
            <model behaviour="block">
                <param name="content" value="let $genres := ancestor::teiHeader//catRef[@scheme eq 'hersch_genre']/tokenize(@target, '\s+') return ext:type-icon(head($genres))"/>
            </model>
            <model behaviour="block">
                <param name="content" value="..//sourceDesc/head(//date)"/>
            </model>
            <model behaviour="block">
                <param name="url" value="$parameters?doc"/>
                <pb:template xml:space="preserve"><a xmlns="" class="nav-btn__circle" href="[[url]]"><img src="resources/images/arrow-right.svg" alt="arrow right"/></a></pb:template>
            </model>
        </modelSequence>
                    <model output="web" behaviour="block"/>
                </elementSpec>
            <elementSpec ident="title" mode="change">
                    <model predicate="$parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="inline"/>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="block"/>
                    <model predicate="$parameters?mode='register-details' and $parameters?static" behaviour="link">
            <param name="uri" value="$parameters?context-path || &#34;/letters/&#34; || util:document-name(.) || '/1/index.html'"/>
            <param name="content" value="string()"/>
        </model>
                    <model predicate="$parameters?mode='register-details'" behaviour="pass-through">
            <desc>create a link to the document, respecting address-by-id configuration</desc>
            <param name="content" value="string()"/>
            <pb:template xml:space="preserve"><em xmlns="">[[content]]</em></pb:template>
        </model>
                    <model predicate="$parameters?display='browse'" behaviour="link" cssClass="document-title">
            <param name="uri" value="$parameters?doc"/>
            <outputRendition xml:space="preserve">
            color: inherit;
            </outputRendition>
        </model>
                    <model predicate="@key or @ref" behaviour="alternate">
            <param name="alternate" value="let $key:= head((@key, @ref))  return collection($global:register-root)/id($key)"/>
            <param name="default" value="."/>
        </model>
                    <model predicate="parent::head/parent::div[@n eq '1']" behaviour="heading">
            <param name="level" value="if (@type eq 'main') then 1 else 2"/>
            <outputRendition xml:space="preserve">
            font-style: normal;
            </outputRendition>
        </model>
                    <model predicate="parent::head" behaviour="inline">
            <outputRendition xml:space="preserve">
            font-style: normal;
            </outputRendition>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
            <elementSpec ident="lb" mode="change">
                    <model behaviour="inline" useSourceRendition="true"/>
                </elementSpec>
            <elementSpec ident="bibl" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model output="print" predicate="contains(@ref, 'GND-')" behaviour="link" cssClass="entity">
            <param name="target" value="'_blank'"/>
            <param name="content" value="."/>
            <param name="uri" value="'https://d-nb.info/gnd/' || substring-after(@ref, 'GND-')"/>
        </model>
                    <model predicate="$parameters?mode eq 'register'" behaviour="listItem">
            <param name="content" value="ext:citation(.)"/>
            <param name="url" value="ext:create-entity-link(., 'bibliography')"/>
            <pb:template xml:space="preserve"><a xmlns="" href="[[url]]">[[content]]</a></pb:template>
        </model>
                    <model predicate="$parameters?display eq 'browse-search'" behaviour="block" cssClass="document-item-search">
            <param name="title" value="ext:div-title(.)"/>
            <param name="url" value="ext:div-url(., $parameters?doc)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="document-title"><a href="[[url]]">[[title]]</a></div><div xmlns=""><a href="[[url]]"><pb-i18n key="menu.register">Index</pb-i18n></a></div><a xmlns="" class="nav-btn__circle" href="[[url]]"><img src="resources/images/arrow-right.svg" alt="arrow right"/></a></pb:template>
        </model>
                    <model predicate="ancestor::sourceDesc and $parameters?mode='metadata-panel'" behaviour="listItem"/>
                    <modelSequence predicate="$parameters?mode='register-details'">
            <desc>Register details view</desc>
            <model behaviour="heading">
                <param name="content" value="title"/>
            </model>
            <model predicate="author" behaviour="pass-through">
                <param name="content" value="string-join(author, ' &amp;amp; ')"/>
                <pb:template xml:space="preserve"><p xmlns=""><span class="register-label"><pb-i18n key="register.works.author">author</pb-i18n>:</span> [[content]]</p></pb:template>
            </model>
            <model behaviour="pass-through">
                <param name="content" value="//ptr"/>
            </model>
            <model predicate="$parameters?mode='register-details'" behaviour="block" cssClass="mentions">
                <desc>List of documents (from data-default collection), where references occur;
                    (shown in register details view only); trying to match by key or ref attributes</desc>
                <param name="content" value="ext:mentions(./@xml:id, 'bibl')"/>
                <pb:template xml:space="preserve"><ul xmlns="">[[content]]</ul></pb:template>
            </model>
        </modelSequence>
                    <model predicate="$parameters?mode='register-overview'" behaviour="pass-through">
            <desc>Register entry overview in list</desc>
            <param name="id" value="@xml:id"/>
            <param name="label" value="ext:citation(.)"/>
            <pb:template xml:space="preserve"><header xmlns="">
                            <a href="bibliography/[[ id ]]">[[ label ]]</a>
                            </header></pb:template>
        </model>
                    <model predicate="parent::listObject" behaviour="link">
            <desc>tooltip content</desc>
            <param name="uri" value="ext:create-entity-link(., 'bibliography')"/>
            <param name="content" value="ext:citation(.)"/>
        </model>
                    <model predicate="@ref or @key" behaviour="alternate" cssClass="bibl context">
            <param name="default" value="."/>
            <param name="alternate" value="let $key:= head((@key, @ref)) let $resolved := id($key, collection($global:register-root)/id('zbz-hersch-works')) return if (count($resolved)) then $resolved else $key"/>
        </model>
                </elementSpec>
                <elementSpec ident="person" mode="change">
                    <model predicate="$parameters?display eq 'browse-search'" behaviour="block" cssClass="document-item-search">
            <param name="title" value="ext:div-title(.)"/>
            <param name="url" value="ext:div-url(., $parameters?doc)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="document-title"><a href="[[url]]">[[title]]</a></div><div xmlns=""><a href="[[url]]"><pb-i18n key="menu.register">Index</pb-i18n></a></div><a xmlns="" class="nav-btn__circle" href="[[url]]"><img src="resources/images/arrow-right.svg" alt="arrow right"/></a></pb:template>
        </model>
                    <model predicate="parent::listPerson and $parameters?mode='register-overview'" behaviour="pass-through">
            <desc>Register entry overview in list</desc>
            <param name="id" value="@xml:id"/>
            <param name="label" value="head((persName[@type='sort'], persName[@type='main'], persName[1]))"/>
            <param name="description" value="note[@type='bio']"/>
            <pb:template xml:space="preserve"><div xmlns="">
<header>
    <a href="people/[[ id ]]">[[ label ]]</a>
</header>
[[ description ]]
</div></pb:template>
        </model>
                    <model predicate="parent::listPerson and $parameters?mode='register'" behaviour="listItem">
            <desc>Register sidebar</desc>
            <param name="content" value="persName[@type=('main', 'full')]"/>
        </model>
                    <modelSequence predicate="parent::listPerson and $parameters?mode='register-details'">
            <desc>Register details view</desc>
            <model behaviour="heading">
                <desc>Heading with full name and dates</desc>
                <param name="content" value="(persName[@type!='variant'])[1]"/>
            </model>
            <model predicate="$parameters?mode='register-details'" behaviour="pass-through">
                <desc>Dates</desc>
                <param name="content" value="(birth, death)"/>
                <pb:template xml:space="preserve"><p xmlns=""><span class="register-label"><pb-i18n key="register.persons.lifespan">lifespan</pb-i18n>:</span> [[content]]</p></pb:template>
            </model>
            <model predicate="$parameters?mode='register-details'" behaviour="pass-through">
                <desc>Additional notes</desc>
                <param name="content" value="note/p/node()"/>
                <pb:template xml:space="preserve"><p xmlns=""><span class="register-label"><pb-i18n key="register.persons.description">description</pb-i18n>:</span> [[content]]</p></pb:template>
            </model>
            <model behaviour="pass-through">
                <desc>Links to wikidata, wikipedia etc.</desc>
                <param name="content" value="listBibl/bibl/ptr"/>
            </model>
            <model predicate="$parameters?mode='register-details'" behaviour="block" cssClass="occupation">
                <desc>Occupation</desc>
                <param name="content" value="occupation"/>
                <outputRendition xml:space="preserve">
                null
                </outputRendition>
            </model>
            <model predicate="$parameters?mode='register-details' and $parameters?static" behaviour="block">
                <desc>List of documents (from data-default collection), where references
                    occur; (shown in register details view only); trying to match by key
                    or ref attributes</desc>
                <param name="content" value="let $id := @xml:id return collection($global:data-default)//text//persName[@key = $id or @ref = $id]/ancestor::TEI/teiHeader//titleStmt"/>
                <pb:template xml:space="preserve"><div xmlns="">
                        <h2>
                            <pb-i18n key="register-details.document-list"/>
                        </h2>
                        <ul>
                            [[content]]
                        </ul>
                    </div></pb:template>
            </model>
            <model predicate="$parameters?mode='register-details' and not($parameters?static)" behaviour="block" cssClass="mentions">
                <desc>List of documents (from data-default collection), where references occur;
                    (shown in register details view only); trying to match by key or ref attributes</desc>
                <param name="content" value="ext:mentions(@xml:id, 'persName')"/>
                <pb:template xml:space="preserve"><ul xmlns="">[[content]]</ul></pb:template>
            </model>
        </modelSequence>
                    <model behaviour="link">
            <desc>tooltip content</desc>
            <param name="uri" value="ext:create-entity-link(., 'people')"/>
            <param name="content" value="head(persName)/string()"/>
        </model>
                </elementSpec>
            <elementSpec ident="pb" mode="change">
                    <model behaviour="inline" cssClass="pb" useSourceRendition="true">
            <param name="content" value="@n"/>
            <outputRendition xml:space="preserve">
            display: block; margin-left: 4pt; color: grey; float: right; font-size: smaller;
            </outputRendition>
        </model>
                </elementSpec>
            <elementSpec ident="div" mode="change">
                    <model predicate="@type eq 'front' and node()" behaviour="block" cssClass="front"/>
                    <model predicate="$parameters?display eq 'browse-search'" behaviour="block" cssClass="document-item-search">
            <param name="title" value="ext:div-title(.)"/>
            <param name="url" value="ext:div-url(., $parameters?doc)"/>
            <param name="type" value="ext:div-type(.)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="document-title"><a href="[[url]]">[[title]]</a></div><div xmlns=""><a href="[[url]]">[[type]]</a></div><a xmlns="" class="nav-btn__circle" href="[[url]]"><img src="resources/images/arrow-right.svg" alt="arrow right"/></a></pb:template>
        </model>
                    <model output="epub" predicate="@n eq '1'" behaviour="pass-through">
            <param name="title" value="head/title[@type eq 'main']"/>
            <param name="content" value="(head/title[not(@type eq 'main')], head/following-sibling::*)"/>
            <param name="year-icon" value="ext:create-icon-year(root(.)//teiHeader)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="flex">[[title]]<div>[[year-icon]]</div></div><div xmlns="">[[content]]</div></pb:template>
        </model>
                    <model output="print" predicate="@n eq '1'" behaviour="pass-through">
            <param name="title" value="head/title[@type eq 'main']"/>
            <param name="content" value="(head/title[not(@type eq 'main')], head/following-sibling::*)"/>
            <param name="year-icon" value="ext:create-icon-year(root(.)//teiHeader)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="flex">[[title]]<div>[[year-icon]]</div></div><div xmlns="">[[content]]</div></pb:template>
        </model>
                    <model output="web" predicate="@n eq '1'" behaviour="pass-through">
            <param name="title" value="head/title[@type eq 'main']"/>
            <param name="content" value="(head/title[not(@type eq 'main')], &lt;div type=&#34;front&#34;&gt;{ancestor::text/front/node()}&lt;/div&gt;, head/following-sibling::*)"/>
            <param name="year-icon" value="ext:create-icon-year(root(.)//teiHeader)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="fixed">[[title]]<div>[[year-icon]]</div></div><div xmlns="" class="scrollable">[[content]]</div></pb:template>
        </model>
                    <model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="let $refs := (root(.)//persName[@key or @ref], root(.)//rs[@type='person'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
            <param name="places" value="let $refs := (root(.)//placeName[@key or @ref], root(.)//rs[@type='place'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3><pb-i18n key="register-details.people">ppl</pb-i18n></h3>
<ul>
[[people]]
</ul>

<h3><pb-i18n key="register-details.places">pl</pb-i18n></h3>
<ul>
[[places]]
</ul>
</div></pb:template>
        </model>
                    <model predicate="parent::body or parent::front or parent::back" behaviour="section"/>
                    <model behaviour="block"/>
                </elementSpec>
                <elementSpec ident="head" mode="change">
                    <model predicate="$parameters?mode='toc'" behaviour="pass-through">
            <param name="content" value="title[@type eq 'main']"/>
        </model>
                    <model predicate="$parameters?display='browse'" behaviour="inline">
            <desc>For browse view and table of contents, just output inline text</desc>
        </model>
                    <model predicate="parent::figure" behaviour="block" cssClass="figure-head"/>
                    <model predicate="parent::table" behaviour="block" cssClass="table-head"/>
                    <model predicate="parent::lg" behaviour="block" cssClass="lg-head"/>
                    <model predicate="parent::list" behaviour="block" cssClass="list-head"/>
                    <model predicate="parent::div" behaviour="heading">
            <param name="level" value="count(ancestor::div)"/>
        </model>
                    <model behaviour="block"/>
                </elementSpec>
            <elementSpec ident="TEI" mode="change">
                    <model output="print" behaviour="document">
            <param name="content" value="(ext:create-qr-code(util:document-name(.)), ext:create-toc(.), //text)"/>
        </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="pass-through">
            <param name="content" value="teiHeader"/>
        </model>
                    <model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through">
            <param name="content" value="teiHeader"/>
        </model>
                    <model predicate="$parameters?mode='edition-navigation' and descendant::correspContext" behaviour="pass-through">
            <desc>process correspContext to provide in-edition navigation buttons to move between documents</desc>
            <param name="content" value="descendant::correspContext"/>
        </model>
                    <model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="let $mentions := (root(.)//text//persName/@key, root(.)//persName/@ref) return if ($mentions) then  for $key in distinct-values($mentions) return collection($global:register-root)/id($key)[self::person] else &lt;pb-i18n key=&#34;register-details.no-people&#34;&gt;No people mentioned&lt;/pb-i18n&gt;"/>
            <param name="works" value="let $mentions := root(.)//bibl/@ref return if ($mentions) then  for $key in distinct-values($mentions) return collection($global:register-root)/id($key)[self::bibl] else &lt;pb-i18n key=&#34;register-details.no-works&#34;&gt;No works mentioned&lt;/pb-i18n&gt;"/>
            <param name="organizations" value="let $mentions := root(.)//org/@ref return if ($mentions) then  for $key in distinct-values($mentions) return collection($global:register-root)/id($key)[self::org] else &lt;pb-i18n key=&#34;register-details.no-organizations&#34;&gt;No orgs mentioned&lt;/pb-i18n&gt;"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3><pb-i18n key="menu.people"/></h3>
<ul>
[[people]]
</ul>
  <h3><pb-i18n key="menu.organisations"/></h3>
<ul>
  [[organizations]]
</ul>
<h3><pb-i18n key="menu.works"/></h3>
<ul>
  [[works]]
</ul>
</div></pb:template>
        </model>
                    <model predicate="text[not(descendant::div)]" behaviour="document">
            <param name="content" value="teiHeader"/>
        </model>
                    <model behaviour="document"/>
                </elementSpec>
            <elementSpec ident="birth" mode="change">
                    <model predicate="$parameters?mode='register-details' and (string-length(@when) gt 0)" behaviour="pass-through">
            <desc>Birth date in individual register page</desc>
            <param name="content" value="try { format-date(xs:date(@when), '[D1] [MNn] [Y]', ($parameters?language, 'en')[1], (), ()) } catch * { @when/string() }"/>
        </model>
                    <model predicate="parent::person and date" behaviour="inline">
            <param name="content" value="(date, if (placeName) then (' (', placeName, ')') else ())"/>
        </model>
                    <model predicate="parent::person" behaviour="inline">
            <param name="content" value="(@when, if (placeName) then (' (', placeName, ')') else ())"/>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="death" mode="change">
                    <model predicate="$parameters?mode='register-details' and (string-length(@when) gt 0)" behaviour="inline">
            <desc>Birth date in individual register page</desc>
            <param name="content" value="try { format-date(xs:date(@when), '[D1] [MNn] [Y]', ($parameters?language, 'en')[1], (), ()) } catch * { @when/string() }"/>
        </model>
                    <model predicate="parent::person and date" behaviour="inline">
            <param name="content" value="(date, if (placeName) then (' (', placeName, ')') else ())"/>
        </model>
                    <model predicate="parent::person" behaviour="inline">
            <param name="content" value="(@when, if (placeName) then (' (', placeName, ')') else ())"/>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="org" mode="add">
                    <model predicate="$parameters?mode='register'" behaviour="listItem">
            <param name="content" value="orgName[1]"/>
        </model>
                    <model predicate="$parameters?display eq 'browse-search'" behaviour="block" cssClass="document-item-search">
            <param name="title" value="ext:div-title(.)"/>
            <param name="url" value="ext:div-url(., $parameters?doc)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="document-title"><a href="[[url]]">[[title]]</a></div><div xmlns=""><a href="[[url]]"><pb-i18n key="menu.register">Index</pb-i18n></a></div><a xmlns="" class="nav-btn__circle" href="[[url]]"><img src="resources/images/arrow-right.svg" alt="arrow right"/></a></pb:template>
        </model>
                    <modelSequence predicate="$parameters?mode='register-details'">
            <model behaviour="heading">
                <param name="content" value="head(orgName)"/>
            </model>
            <model behaviour="pass-through">
                <param name="content" value="listBibl/bibl/ptr"/>
            </model>
            <model behaviour="block" cssClass="mentions">
                <param name="content" value="ext:mentions(., 'orgName')"/>
                <pb:template xml:space="preserve"><ul xmlns="">[[content]]</ul></pb:template>
            </model>
        </modelSequence>
                    <model predicate="$parameters?mode='register-overview'" behaviour="pass-through">
            <param name="id" value="@xml:id"/>
            <param name="label" value="head((orgName[@type='sort'], orgName[@type='main'], orgName[1]))"/>
            <pb:template xml:space="preserve"><div xmlns="">
<header>
    <a href="organizations/[[ id ]]">[[ label ]]</a>
</header>
[[ description ]]
</div></pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="idno" mode="change">
                    <model predicate="@subtype eq 'swisscovery'" behaviour="pass-through">
            <pb:template xml:space="preserve"><a xmlns="" href="[[content]]" target="_blank">[[content]]</a></pb:template>
        </model>
                    <model predicate="@type eq 'MLA-9'" behaviour="inline"/>
                    <model predicate="@type='ISBN'" behaviour="pass-through">
            <param name="type" value="@type"/>
            <pb:template xml:space="preserve"><div xmlns="">
                            <b>[[type]]</b>: [[content]]
                        </div></pb:template>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="publicationStmt" mode="change">
                    <model predicate="$parameters?mode='dcmi'" behaviour="pass-through">
            <param name="date" value="date"/>
            <param name="edition" value="util:document-name(.)"/>
            <pb:template xml:space="preserve"><meta xmlns="" name="edition:work" content="[[edition]]"/>
<meta xmlns="" name="DC.date" content="[[date]]"/></pb:template>
        </model>
                    <model predicate="$parameters?display='browse'" behaviour="block">
            <param name="content" value=".//availability"/>
        </model>
                    <model behaviour="block"/>
                </elementSpec>
            <elementSpec ident="category" mode="add"/>
                <elementSpec ident="catDesc" mode="add">
                    <model predicate="$parameters?display eq 'browse-search'" behaviour="block" cssClass="document-item-search">
            <param name="url" value="'topics.html'"/>
            <param name="lang" value="./@xml:lang/string()"/>
            <param name="title" value="let $lang := ./@xml:lang/string() return ./ancestor::taxonomy/desc[@xml:lang eq $lang]/string()"/>
            <pb:template xml:space="preserve"><div xmlns="" class="document-title"><a href="[[url]]">[[title]]</a></div><div xmlns=""><a href="[[url]]"><pb-i18n key="menu.register">Index</pb-i18n></a></div><a xmlns="" class="nav-btn__circle" href="[[url]]?lang=[[lang]]"><img src="resources/images/arrow-right.svg" alt="arrow right"/></a></pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="ptr" mode="change">
                    <model predicate="@type eq 'DNB'" behaviour="pass-through">
            <param name="uri" value="@target"/>
            <param name="content" value="@target"/>
            <pb:template xml:space="preserve"><p xmlns=""><span class="register-label"><pb-i18n key="register.persons.dnblink">dnblink</pb-i18n>:</span> <a href="[[uri]]" target="_blank">[[content]]</a></p></pb:template>
        </model>
                    <model predicate="@type = ('GND', 'gnd')" behaviour="pass-through">
            <param name="content" value="substring-after(@target, 'gnd/')"/>
            <param name="uri" value="@target"/>
            <pb:template xml:space="preserve"><p xmlns=""><span class="register-label"><pb-i18n key="register.persons.gndid">gndid</pb-i18n>:</span> <a href="[[uri]]" target="_blank">[[content]]</a></p></pb:template>
        </model>
                    <model predicate="parent::notatedMusic" behaviour="pass-through">
            <desc>Load and display external MEI</desc>
            <param name="url" value="@target"/>
            <pb:template xml:space="preserve"><pb-mei xmlns="" url="[[url]]" player="player">
                                        <pb-option name="appXPath" on="./rdg[contains(@label, 'original')]" off="">Original Clefs</pb-option>
                                        </pb-mei></pb:template>
        </model>
                    <model predicate="(parent::place or parent::person) and @target" behaviour="listItem">
            <desc>Output as list item in register view</desc>
            <param name="target" value="@target"/>
            <param name="content" value="@type"/>
            <pb:template xml:space="preserve"><a xmlns="" href="[[target]]" target="_blank">[[content]]</a></pb:template>
        </model>
                    <model predicate="@target" behaviour="link">
            <param name="uri" value="@target"/>
            <param name="content" value="if (@type) then @type else ."/>
        </model>
                </elementSpec>
            <elementSpec ident="date" mode="change">
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb'" behaviour="inline">
            <param name="content" value="if (@when) then replace(@when, '^(\d{4}).*?$', '$1') else (@from, '–', &lt;br xmlns=&#34;http://www.w3.org/1999/xhtml&#34;/&gt;, @to)"/>
        </model>
                    <model predicate="@when" behaviour="alternate">
            <param name="default" value="if (normalize-space(.)) then . else @when/string()"/>
            <param name="alternate" value="try { format-date(xs:date(@when), '[D1o] [MNn] [Y]', ($parameters?language, 'en')[1], (), ()) } catch * { @when/string() }"/>
        </model>
                    <model behaviour="inline"/>
                </elementSpec>
                <elementSpec ident="biblStruct" mode="add">
                    <model behaviour="block">
            <param name="title" value="ancestor::teiHeader//titleStmt/title[@subtype eq 'main']"/>
            <param name="broadcaster" value="//imprint/publisher/string()"/>
            <param name="note" value="//note[@type='archive']/node()"/>
            <param name="year-icon" value="ext:create-icon-year(ancestor::teiHeader)"/>
            <pb:template xml:space="preserve"><div xmlns="" class="flex"><h1>[[title]]</h1><div class="icon-year">[[year-icon]]</div></div>
<div xmlns="">
<ul>
  <li><strong><pb-i18n key="appearances.broadcaster">broadcaster</pb-i18n></strong>: [[broadcaster]]</li>
   <li><strong><pb-i18n key="appearances.archivenote">archivenote</pb-i18n></strong>: [[note]]</li>
</ul>  
</div>
</pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="back" mode="change">
                    <model behaviour="block" cssClass="back"/>
                </elementSpec>
                <elementSpec ident="front" mode="change">
                    <model behaviour="omit"/>
                </elementSpec>
            <elementSpec ident="object" mode="add">
                    <model behaviour="pass-through">
            <param name="title" value="//objectName"/>
            <param name="url" value="'../'|| @corresp"/>
            <pb:template xml:space="preserve"><div xmlns=""><h2>[[title]]</h2>
<object class="matomo_download" data="[[url]]" type="application/pdf" style="width:100%; height:35rem;">
  <p>Your browser does not support PDFs.
        <a href="[[url]]">Download the PDF</a>.
    </p>
</object>
</div></pb:template>
        </model>
                </elementSpec>
            <elementSpec ident="quote" mode="change">
                    <model predicate="ancestor::p or ancestor::cell or ancestor::cit" behaviour="inline" useSourceRendition="true">
            <desc>If inside a paragraph, table cell or citation then rendered inline</desc>
        </model>
                    <model behaviour="block" cssClass="block-quote" useSourceRendition="true"/>
                </elementSpec>
            </schemaSpec>
        </body>
    </text>
</TEI>